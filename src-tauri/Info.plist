<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 声明 App 支持的界面语言，供 macOS 选取 Apple 框架自带 UI（如原生打开/保存面板、
	     右键菜单等）的本地化。缺少此声明时 Tauri 默认 CFBundleDevelopmentRegion=English，
	     即使系统为中文，原生面板也会回退成英文。 -->
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleAllowMixedLocalizations</key>
	<true/>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>zh-Hans</string>
		<string>zh_CN</string>
	</array>
	<!-- 显式声明文档类型并附带自定义图标（.icns）：Tauri 的 bundle.fileAssociations 只写关联、
	     不写 CFBundleTypeIconFile，导致 .mdl/.mdlb 在 Finder 里回退为「通用文档 + App 图标徽标」。
	     Tauri 合并 Info.plist 时数组整体替换，这里定义的会覆盖自动生成的版本。
	     图标路径相对 Contents/Resources，由 bundle.resources 把 icons/filetypes/*.icns 拷入。 -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>md</string>
				<string>markdown</string>
			</array>
			<key>CFBundleTypeName</key>
			<string>Markdown 文档</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleTypeIconFile</key>
			<string>icons/filetypes/md.icns</string>
			<key>LSHandlerRank</key>
			<string>Default</string>
		</dict>
		<dict>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>mdl</string>
			</array>
			<key>CFBundleTypeName</key>
			<string>MarkLock 加密文件</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleTypeIconFile</key>
			<string>icons/filetypes/mdl.icns</string>
			<key>LSHandlerRank</key>
			<string>Default</string>
		</dict>
		<dict>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>mdlb</string>
			</array>
			<key>CFBundleTypeName</key>
			<string>MarkLock 加密库</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleTypeIconFile</key>
			<string>icons/filetypes/mdlb.icns</string>
			<key>LSHandlerRank</key>
			<string>Default</string>
		</dict>
	</array>
</dict>
</plist>
